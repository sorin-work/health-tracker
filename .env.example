# Copy to .env and adjust. docker compose reads .env automatically.

# Host ports (container ports stay the same)
DB_PORT=5435
API_PORT=4300
WEB_PORT=5176

# Postgres credentials used by the db and api services
POSTGRES_USER=health
POSTGRES_PASSWORD=health
POSTGRES_DB=health

# Signs login tokens. Use a long random value (at least 32 characters) anywhere but your laptop.
JWT_SECRET=local-development-secret-change-me-0123456789

# Create demo@example.com / demo-password with a year of sample data on first start.
SEED_DEMO=true
